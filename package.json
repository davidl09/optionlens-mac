{
  "name": "optionlens-mac",
  "productName": "OptionLens",
  "description": "OptionLens desktop app: analytics UI, server pairing and the IBKR bridge",
  "desktopName": "optionlens.desktop",
  "author": "OptionLens",
  "license": "UNLICENSED",
  "private": true,
  "version": "0.1.32",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build:renderer && npm run build:electron && electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "dist:mac": "npm run build && electron-builder --mac dir --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@stoqey/ib": "1.6.13",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "echarts": "^5.6.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "5.1.0"
  }
}
